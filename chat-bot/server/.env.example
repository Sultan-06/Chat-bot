# ============================================
# Aura AI – Backend Environment Configuration
# Copy this file to .env and fill in values.
# ============================================

# AI Provider Configuration
# Choose one provider and fill in its details.

AI_PROVIDER=groq
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173,https://Sultan-06.github.io

# =============================================
# Provider Presets (uncomment one block below)
# =============================================

# --- Groq (Free Tier Default) ---
# AI_PROVIDER=groq
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
# Get a free key at: https://console.groq.com

# --- OpenAI ---
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# Get a key at: https://platform.openai.com

# --- Google Gemini (OpenAI-Compatible) ---
